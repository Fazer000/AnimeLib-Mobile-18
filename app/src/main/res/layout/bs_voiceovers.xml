<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="0dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bottom_sheet_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/open_sans_bold"
            android:letterSpacing="0.01"
            android:text="Озвучка"
            android:textColor="@color/primary_text_color"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/btnDownloadFromMenu"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_ripple_effect"
            android:contentDescription="Download Episodes"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_download"
            app:tint="@color/secondary_text_color" />

        <ImageButton
            android:id="@+id/closeMenuButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/button_close_background"
            android:contentDescription="Close Menu"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/accent_text_color" />

    </LinearLayout>

    <!-- Player Selector TabLayout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="4dp"
        android:background="@android:color/transparent"
        app:tabIndicatorColor="@color/purple_primary"
        app:tabSelectedTextColor="@color/purple_primary"
        app:tabTextColor="@color/secondary_text_color"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <!-- Players List Container with loading overlay -->
    <FrameLayout
        android:id="@+id/playersContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVoiceovers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp"
            android:clipToPadding="false"
            android:paddingBottom="0dp" />

        <FrameLayout
            android:id="@+id/menuLoadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bs_bg_color"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/menuLoadingIndicator"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                app:indicatorColor="@color/purple_primary"
                app:trackCornerRadius="8dp"
                app:trackThickness="4dp" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
