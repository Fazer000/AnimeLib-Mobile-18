<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bookmark_item_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="2dp"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="@color/card_bg_color"
    app:cardElevation="0dp"
    app:cardMaxElevation="0dp"
    android:elevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:foreground="?attr/selectableItemBackground">

        <!-- Обложка аниме -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            android:elevation="0dp">

            <ImageView
                android:id="@+id/anime_cover"
                android:layout_width="48dp"
                android:layout_height="64dp"
                android:scaleType="centerCrop"
                android:contentDescription="Обложка аниме"
                android:background="@drawable/placeholder_image" />
        </androidx.cardview.widget.CardView>

        <!-- Информация о закладке -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <!-- Название аниме (сверху) -->
            <TextView
                android:id="@+id/anime_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Название аниме"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/primaryTextColor"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Заполнитель пространства для раздвижения по вертикали -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Эпизод и Время (снизу) -->
            <TextView
                android:id="@+id/episode_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Эпизод 1 — 06:00 из 14:29"
                android:textSize="11sp"
                android:textColor="?attr/accentTextColor"
                android:layout_marginBottom="2dp" />

            <!-- Прогресс-бар (снизу) -->
            <ProgressBar
                android:id="@+id/bookmark_item_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="100"
                android:progress="40"
                android:progressDrawable="@drawable/bookmark_card_progress_drawable" />

            <!-- Запасное скрытое поле -->
            <TextView
                android:id="@+id/progress_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
