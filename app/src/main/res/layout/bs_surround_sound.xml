<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bottom_sheet_handle"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                app:tint="@color/accent_text_color"
                android:background="@drawable/button_close_background"
                android:src="@drawable/ic_arrow_back"
                android:scaleType="fitCenter"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Объемный звук"
                android:textColor="@color/primary_text_color"
                android:textStyle="bold"
                android:fontFamily="@font/open_sans_bold"
                android:paddingVertical="12dp"
                android:textSize="18sp"
                android:layout_marginStart="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:background="@drawable/tag_51_surround_background"
                android:text="3D"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                app:tint="@color/accent_text_color"
                android:background="@drawable/button_close_background"
                android:src="@drawable/ic_close"
                android:scaleType="fitCenter"
                android:contentDescription="Close"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/bs_divider_color"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Main Toggle Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:background="@drawable/settings_option_background">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_surround_sound"
                    app:tint="@color/secondary_text_color"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Объемный звук"
                        android:textColor="@color/primary_text_color"
                        android:fontFamily="@font/open_sans_bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Пространственная аудиосистема"
                        android:textColor="@color/accent_text_color"
                        android:textSize="12sp"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/surroundMainSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    app:trackTint="@color/switch_track_tint"
                    app:thumbTint="@color/switch_thumb_tint"
                    android:checked="true"/>
            </LinearLayout>

            <!-- Container for controls when enabled -->
            <LinearLayout
                android:id="@+id/surroundControlsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <!-- Mode Selection Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Режим 3D Звука:"
                    android:textColor="@color/accent_text_color"
                    android:textSize="13sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:layout_marginBottom="8dp"/>

                <!-- Mode Option 0: Cinema 3D -->
                <LinearLayout
                    android:id="@+id/modeCinemaOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/settings_option_background"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_tv"
                        app:tint="@color/secondary_text_color"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎬 Кинотеатр 3D"
                            android:textColor="@color/primary_text_color"
                            android:fontFamily="@font/open_sans_bold"
                            android:textSize="15sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Глубокая сцена, кинобас и объемный эффект"
                            android:textColor="@color/accent_text_color"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/checkCinema"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/secondary_text_color"
                        android:visibility="visible"/>
                </LinearLayout>

                <!-- Mode Option 1: Concert 3D -->
                <LinearLayout
                    android:id="@+id/modeConcertOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/settings_option_background"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/accent_text_color"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎧 Концерт &amp; OST 3D"
                            android:textColor="@color/primary_text_color"
                            android:fontFamily="@font/open_sans_bold"
                            android:textSize="15sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Широкое стерео и чистые опенинги"
                            android:textColor="@color/accent_text_color"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/checkConcert"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/secondary_text_color"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- Mode Option 2: Voice Focus 3D -->
                <LinearLayout
                    android:id="@+id/modeVoiceOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/settings_option_background"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_voice"
                        app:tint="@color/accent_text_color"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎙️ Четкая Озвучка 3D"
                            android:textColor="@color/primary_text_color"
                            android:fontFamily="@font/open_sans_bold"
                            android:textSize="15sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Фокус на голосах сейю и дубляжа"
                            android:textColor="@color/accent_text_color"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/checkVoice"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/secondary_text_color"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- Mode Option 3: Classic 5.1 -->
                <LinearLayout
                    android:id="@+id/modeClassicOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/settings_option_background"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_surround_sound"
                        app:tint="@color/accent_text_color"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔊 Классический 5.1"
                            android:textColor="@color/primary_text_color"
                            android:fontFamily="@font/open_sans_bold"
                            android:textSize="15sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Стандартный естественный 5.1 микс"
                            android:textColor="@color/accent_text_color"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/checkClassic"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/secondary_text_color"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- Mode Option 4: Extreme 3D HRTF -->
                <LinearLayout
                    android:id="@+id/modeExtremeOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/settings_option_background"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_tune_sliders"
                        app:tint="@color/accent_text_color"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌌 Экстрим 3D HRTF"
                            android:textColor="@color/primary_text_color"
                            android:fontFamily="@font/open_sans_bold"
                            android:textSize="15sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Максимальная бинауральная 3D глубина"
                            android:textColor="@color/accent_text_color"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/checkExtreme"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/secondary_text_color"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- Section: Fine Tuning Controls -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Объем 3D Сцены:"
                    android:textColor="@color/accent_text_color"
                    android:textSize="13sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:layout_marginBottom="6dp"/>

                <!-- Width Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/chipWidth0"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Узкая"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipWidth1"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_selected"
                        android:gravity="center"
                        android:text="Норма"
                        android:textColor="@color/secondary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipWidth2"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Широкая"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipWidth3"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Ультра 3D"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- Dialogue Boost Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Четкость Озвучки / Голоса:"
                    android:textColor="@color/accent_text_color"
                    android:textSize="13sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:layout_marginBottom="6dp"/>

                <!-- Dialogue Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/chipDialogue0"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Обычная"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipDialogue1"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_selected"
                        android:gravity="center"
                        android:text="Четкая"
                        android:textColor="@color/secondary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipDialogue2"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Усиленная"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipDialogue3"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Максимум"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- Bass Boost Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Глубокий Бас LFE:"
                    android:textColor="@color/accent_text_color"
                    android:textSize="13sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:layout_marginBottom="6dp"/>

                <!-- Bass Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/chipBass0"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Мягкий"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipBass1"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_selected"
                        android:gravity="center"
                        android:text="Кинотеатр"
                        android:textColor="@color/secondary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipBass2"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Мощный"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipBass3"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Экстрим"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- Treble / Air Boost Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Высокие частоты (Treble &amp; Air):"
                    android:textColor="@color/accent_text_color"
                    android:textSize="13sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:layout_marginBottom="6dp"/>

                <!-- Treble Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipTreble0"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Мягкие"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipTreble1"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_selected"
                        android:gravity="center"
                        android:text="Чистые"
                        android:textColor="@color/secondary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipTreble2"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Звонкие"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipTreble3"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Ультра Air"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
