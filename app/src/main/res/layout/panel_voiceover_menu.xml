<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/slidingMenuPanel"
    android:layout_width="360dp"
    android:layout_height="match_parent"
    android:layout_gravity="end">

    <!-- Drag Handle - слева вертикально -->
    <FrameLayout
        android:id="@+id/dragZone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:paddingHorizontal="8dp">

        <View
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/drag_handle" />
    </FrameLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:elevation="16dp"
        android:outlineProvider="bounds"
        app:cardBackgroundColor="@color/bs_bg_color"
        app:cardCornerRadius="20dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <!-- Main Content -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/bs_bg_color"
                        app:cardBackgroundColor="@color/bs_bg_color"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <!-- Menu Header -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="16dp"
                                android:paddingTop="14dp"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:letterSpacing="0.01"
                                    android:text="Озвучка"
                                    android:textColor="@color/primary_text_color"
                                    android:textSize="20sp"
                                    android:fontFamily="@font/open_sans_bold" />

                                <ImageButton
                                    android:id="@+id/btnDownloadFromMenu"
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:background="@drawable/button_ripple_effect"
                                    android:contentDescription="Download Episodes"
                                    android:padding="7dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_download"
                                    app:tint="@color/secondary_text_color"
                                    android:layout_marginEnd="6dp" />

                                <ImageButton
                                    android:id="@+id/closeMenuButton"
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:background="@drawable/button_close_background"
                                    android:contentDescription="Close Menu"
                                    android:padding="7dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_close"
                                    app:tint="@color/accent_text_color" />

                            </LinearLayout>

                            <!-- Player Selector TabLayout -->
                            <com.google.android.material.tabs.TabLayout
                                android:id="@+id/tabLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="16dp"
                                android:layout_marginVertical="4dp"
                                android:background="@android:color/transparent"
                                app:tabIndicatorColor="@color/purple_primary"
                                app:tabSelectedTextColor="@color/purple_primary"
                                app:tabTextColor="@color/secondary_text_color"
                                app:tabMode="fixed"
                                app:tabGravity="fill" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Players List Container with loading overlay -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/playersContainer"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/bs_bg_color"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvVoiceovers"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:paddingBottom="16dp" />

                        <FrameLayout
                            android:id="@+id/menuLoadingOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/bs_bg_color"
                            android:visibility="visible">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/menuLoadingIndicator"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center"
                                android:indeterminate="true"
                                app:indicatorColor="@color/purple_primary"
                                app:trackCornerRadius="8dp"
                                app:trackThickness="4dp" />
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
