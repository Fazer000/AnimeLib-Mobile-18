<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/portraitScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bs_bg_color"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:clipToPadding="false"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Кнопка озвучек (слева озвучка, справа плеер) и кнопка закладки в одной линии -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="14dp">

            <!-- Кнопка озвучки и плеера -->
            <LinearLayout
                android:id="@+id/portraitVoiceoverPlayerButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_portrait_block_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="10dp">

                <TextView
                    android:id="@+id/tvPortraitVoiceover"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Озвучка"
                    android:textColor="@color/primary_text_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPortraitPlayer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Плеер"
                    android:textColor="@color/accent_text_color"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Select Voiceover"
                    app:tint="@color/accent_text_color" />
            </LinearLayout>

            <!-- Кнопка закладки -->
            <ImageButton
                android:id="@+id/portraitBookmarkButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_portrait_block_button"
                android:contentDescription="Bookmark"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bookmark"
                app:tint="@color/primary_text_color" />

        </LinearLayout>

        <!-- 2. Карусель эпизодов -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/portraitEpisodesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- 3. Название аниме и под ним название серии -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvPortraitAnimeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/primary_text_color"
                android:textSize="18sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.1" />

            <TextView
                android:id="@+id/tvPortraitEpisodeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/accent_text_color"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bs_divider_color"
            android:layout_marginBottom="16dp" />

        <!-- 4. Комментарии -->
        <LinearLayout
            android:id="@+id/portraitCommentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Заголовок комментариев (Сортировка + Правила) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/btnPortraitSortComments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_comment_header_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_sort_arrows"
                        app:tint="@color/accent_text_color"
                        android:contentDescription="Sort" />

                    <TextView
                        android:id="@+id/tvPortraitSortComments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Новые"
                        android:textColor="@color/accent_text_color"
                        android:textSize="13sp"
                        android:fontFamily="@font/open_sans_bold" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnPortraitCommentRules"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rules_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:text="ПРАВИЛА"
                    android:textColor="@color/accent_text_color"
                    android:textSize="11sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:letterSpacing="0.06" />

            </LinearLayout>

            <!-- Поле ввода комментария -->
            <LinearLayout
                android:id="@+id/portraitCommentInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_comment_input"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Reply Bar (Hidden by default) -->
                <LinearLayout
                    android:id="@+id/portraitReplyBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvPortraitReplyToText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/secondary_color"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:ellipsize="end"
                        android:singleLine="true" />

                    <ImageButton
                        android:id="@+id/btnPortraitCancelReply"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Cancel reply"
                        android:padding="2dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/accent_text_color" />
                </LinearLayout>

                <!-- Formatting Bar Row (above input) -->
                <LinearLayout
                    android:id="@+id/portraitFormattingBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="2dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/btnPortraitFormatBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="36dp"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:text=" B "
                        android:textColor="@color/accent_text_color"
                        android:textSize="15sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Bold" />

                    <TextView
                        android:id="@+id/btnPortraitFormatItalic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="36dp"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:text=" I "
                        android:textColor="@color/accent_text_color"
                        android:textSize="15sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:textStyle="italic"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Italic" />

                    <TextView
                        android:id="@+id/btnPortraitFormatUnderline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="36dp"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:text=" U "
                        android:textColor="@color/accent_text_color"
                        android:textSize="15sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Underline" />

                    <TextView
                        android:id="@+id/btnPortraitFormatStrike"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="36dp"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:text=" S "
                        android:textColor="@color/accent_text_color"
                        android:textSize="15sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Strikethrough" />

                    <TextView
                        android:id="@+id/btnPortraitFormatSpoiler"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="36dp"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:text=" [!] "
                        android:textColor="@color/accent_text_color"
                        android:textSize="15sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Spoiler" />

                    <TextView
                        android:id="@+id/btnPortraitFormatQuote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="36dp"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:text=" ” "
                        android:textColor="@color/accent_text_color"
                        android:textSize="16sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Quote" />
                </LinearLayout>

                <!-- Input Field Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/portraitCommentInputField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Написать комментарий..."
                        android:textColorHint="@color/accent_text_color"
                        android:textColor="@color/primary_text_color"
                        android:textSize="14sp"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="6dp"
                        android:maxLines="3"
                        android:inputType="textMultiLine"
                        android:imeOptions="flagNoExtractUi|flagNoFullscreen" />

                    <ImageButton
                        android:id="@+id/btnPortraitSendComment"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Send comment"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_send"
                        app:tint="@color/secondary_color" />
                </LinearLayout>

            </LinearLayout>

            <!-- Список комментариев -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/portraitCommentsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/tvPortraitEmptyComments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:paddingVertical="24dp"
                    android:text="Комментариев пока нет"
                    android:textColor="@color/accent_text_color"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/portraitCommentsLoadingOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        app:indicatorColor="?attr/secondaryColor"
                        app:trackCornerRadius="8dp"
                        app:trackThickness="4dp" />
                </FrameLayout>
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

